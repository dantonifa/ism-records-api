{
  "openapi": "3.0.0",
  "info": {
    "title": "Instituto Privado Salvador Moncada API",
    "version": "1.0.0",
    "description": "Simplified API documentation for student records and teacher profiles"
  },
  "servers": [
    {
      "url": "https://cse-341-ism-records-api.onrender.com",
      "description": "Production Render Server"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/api/students": {
      "get": {
        "summary": "List or search student profiles",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Search studentId, first name, last name, or email"
          },
          {
            "name": "studentId",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["active", "archived", "all"],
              "default": "active"
            }
          },
          {
            "name": "x-user-role",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["administrator", "teacher", "staff"]
            }
          }
        ],
        "responses": {
          "200": { "description": "Student list returned" },
          "400": { "description": "Invalid query parameters" },
          "401": { "description": "Missing role header" },
          "403": { "description": "Role is not authorized" },
          "500": { "description": "Server error" }
        }
      },
      "post": {
        "summary": "Create a student profile",
        "parameters": [
          {
            "name": "x-user-role",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["administrator", "teacher", "staff"]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Student" }
            }
          }
        },
        "responses": {
          "201": { "description": "Student created" },
          "400": { "description": "Validation failed" },
          "401": { "description": "Missing role header" },
          "403": { "description": "Role is not authorized" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/api/students/{id}": {
      "get": {
        "summary": "Get a student profile by studentId",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "x-user-role",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["administrator", "teacher", "staff"]
            }
          }
        ],
        "responses": {
          "200": { "description": "Student found" },
          "401": { "description": "Missing role header" },
          "403": { "description": "Role is not authorized" },
          "404": { "description": "Student not found" },
          "500": { "description": "Server error" }
        }
      },
      "patch": {
        "summary": "Update a student profile",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "x-user-role",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["administrator", "teacher", "staff"]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StudentUpdate" }
            }
          }
        },
        "responses": {
          "200": { "description": "Student updated" },
          "400": { "description": "Validation failed" },
          "401": { "description": "Missing role header" },
          "403": { "description": "Role is not authorized" },
          "404": { "description": "Student not found" }
        }
      },
      "delete": {
        "summary": "Archive a student profile (remove from normal use)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "x-user-role",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["administrator", "teacher", "staff"]
            }
          }
        ],
        "responses": {
          "200": { "description": "Student archived" },
          "401": { "description": "Missing role header" },
          "403": { "description": "Role is not authorized" },
          "404": { "description": "Student not found" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/api/grades/submit": {
      "post": {
        "summary": "Submit grades for secretary review",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["teacherId", "subjectId", "courseSection"],
                "properties": {
                  "teacherId": { "type": "string", "description": "Teacher MongoDB ObjectId" },
                  "subjectId": { "type": "string" },
                  "courseSection": { "type": "string" },
                  "term": { "type": "string" },
                  "grades": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["studentId", "score"],
                      "properties": {
                        "studentId": { "type": "string" },
                        "score": { "type": "number", "minimum": 0, "maximum": 100 },
                        "comments": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Submission created with PENDING_REVIEW status" },
          "400": { "description": "Invalid JSON or submission" },
          "500": { "description": "Submission could not be saved" }
        }
      }
    },
    "/teachers": {
      "get": {
        "summary": "Get all teacher profiles",
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "post": {
        "summary": "Create a new teacher profile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Teacher"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Validation Failed"
          }
        }
      }
    },
    "/teachers/{id}": {
      "get": {
        "summary": "Get teacher by teacherId",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "put": {
        "summary": "Update teacher profile properties",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Teacher"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "400": {
            "description": "Validation Failed"
          }
        }
      },
      "delete": {
        "summary": "Delete teacher file completely",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted Successfully"
          }
        }
      }
    },
    "/records": {
      "get": {
        "summary": "Get all student records",
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "post": {
        "summary": "Create a new student record",
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/records/{id}": {
      "get": {
        "summary": "Get student record by studentId",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Student": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "studentId",
          "firstName",
          "lastName",
          "email",
          "gradeLevel",
          "section",
          "year"
        ],
        "properties": {
          "studentId": { "type": "string" },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "phone": { "type": "string" },
          "gradeLevel": { "type": "string" },
          "section": { "type": "string" },
          "year": { "type": "integer", "minimum": 2000, "maximum": 2100 },
          "status": { "type": "string", "enum": ["active", "archived"] }
        }
      },
      "StudentUpdate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "phone": { "type": "string" },
          "gradeLevel": { "type": "string" },
          "section": { "type": "string" },
          "year": { "type": "integer", "minimum": 2000, "maximum": 2100 },
          "status": { "type": "string", "enum": ["active", "archived"] }
        }
      },
      "Teacher": {
        "type": "object",
        "required": ["teacherId", "name", "department", "email"],
        "properties": {
          "teacherId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        }
      }
    }
  }
}
